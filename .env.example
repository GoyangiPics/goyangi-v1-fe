# PocketBase backend URL (used by the frontend to make API calls).
# In dev this defaults to http://127.0.0.1:8090/ via nuxt.config.ts.
NUXT_PUBLIC_BASE_URL=https://dev-api.goyangi.pics/

# CDN / file host URL (where uploaded media is served from).
# In dev this defaults to https://dev-cdn.goyangi.pics/.
NUXT_PUBLIC_HOST_URL=https://dev-cdn.goyangi.pics/

# Contact routes shown on /about and in the "upload access required" banner.
# Point these at a staging Discord / inbox for non-production deploys.
NUXT_PUBLIC_DISCORD_INVITE=https://discord.gg/BmWMXFrZeK
NUXT_PUBLIC_SUPPORT_EMAIL=goyangi.pics@protonmail.com
